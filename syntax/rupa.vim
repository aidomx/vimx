" Braces
syn match rupaBrace /[{}]/
syn match rupaParen /[()]/
syn match rupaBracket /[\[\]]/

" Colon (used in objects, functions, case)
syn match rupaColon /:/

syn match rupaIdentifier /\<\h\w*\>/
syn match rupaFunction /\<\h\w*\>\ze\s*(/
syn match rupaProperty /\.\zs\h\w*/
syn match rupaImport "^import\s"
syn match rupaImport "\sfrom\s"
syn match rupaImportPath "\.\.\?/[\w.]*"
syn match rupaImportAs /\sas\s/

