endif

" Keywords
syn keyword rupaKeyword if else for while return import export from async await this case rev break continue
syn keyword rupaType boolean double float number string
syn keyword rupaConstant null undefined
syn keyword rupaBoolean true false
syn keyword rupaBuiltin print exit

syn match rupaNumber "\d\+"
syn match rupaDecimal "\d\+\.\d\+"

syn region rupaString start=+"+ end=+"+ oneline contains=rupaEscape
syn region rupaString start=+'+ end=+'+ oneline contains=rupaEscape

"syn match rupaComment /^\/\/.*/
syn region rupaComment start="/\*" end="\*/"
syn match rupaComment "#.*"
syn match rupaComment /^\s*\/\/.*$/

" Operators
syn match rupaCompOp /!=\|==\|>=\|<=\|>\|<\|->/
syn match rupaOp /=>/
syn match rupaStepOp /++\|--/
syn match rupaOp /\.\.\./
syn match rupaOp /&&\|||/
syn match rupaOp /\*/
syn match rupaOp "?="
syn match rupaOp "="
syn match rupaOp ":"
syn match rupaOp "+"
syn match rupaOp "-"
syn match rupaOp "/\%([/s*]\)\@!"
syn match rupaOp "%"
"syn match rupaOp "\."
syn match rupaOp ","
syn match rupaOp "|"
syn match rupaEscape /\\[nrt\\'"]\+/ contained

"syn match rupaCompOp "=="
"syn match rupaCompOp "==="
"syn match rupaCompOp "!="
"syn match rupaCompOp "!=="
"syn match rupaCompOp ">="
